{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "zh-patch 配置",
  "type": "object",
  "required": [
    "app",
    "dict"
  ],
  "properties": {
    "app": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "显示名，macOS 上用于 osascript 退出"
        },
        "path": {
          "type": "string",
          "description": "macOS: .app 路径；Windows: .exe；Linux: 可执行文件"
        },
        "processPattern": {
          "type": "string",
          "description": "pgrep 用的进程匹配串"
        },
        "launchArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "debug": {
      "type": "object",
      "properties": {
        "pagePort": {
          "type": "integer",
          "default": 9333,
          "description": "渲染进程调试端口"
        },
        "inspectPort": {
          "type": "integer",
          "default": 9229,
          "description": "主进程 Node inspector 端口（用于汉化原生菜单，可设 0 关闭）"
        }
      }
    },
    "dict": {
      "type": "string",
      "description": "相对配置文件的词典路径"
    },
    "engine": {
      "type": "object",
      "properties": {
        "attrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipTags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipSelector": {
          "type": "string"
        },
        "pseudoAttrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attrMaxLength": {
          "type": "integer"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "menu": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "extraKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "watch": {
      "type": "object",
      "properties": {
        "intervalMs": {
          "type": "integer"
        },
        "menuIntervalMs": {
          "type": "integer"
        },
        "exitAfterIdleMs": {
          "type": "integer"
        }
      }
    },
    "imagegen": {
      "type": "object",
      "description": "生图旁路：把宿主 App 的托管出图请求（如 Pen 的 POST https://api.pencil.dev/generate-image）转发到你自己的 OpenAI 兼容出图服务。默认关闭。",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "match": {
          "type": "string",
          "description": "命中宿主请求 URL 的片段"
        },
        "bridgePort": {
          "type": "integer",
          "default": 3001
        },
        "bridgeUrl": {
          "type": "string",
          "description": "转发器对外地址，必须落在宿主 CSP 的 connect-src 白名单内"
        },
        "bridgePath": {
          "type": "string",
          "default": "/generate-image"
        },
        "bridgeToken": {
          "type": [
            "string",
            "null"
          ],
          "description": "可选的本地校验头 x-zh-patch"
        },
        "baseUrl": {
          "type": "string",
          "description": "你的 OpenAI 兼容出图服务，例如 http://127.0.0.1:8080/v1"
        },
        "apiKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": "string",
          "description": "宿主模型名（走 combo 路由时通常填 gpt-5.5）"
        },
        "toolModel": {
          "type": "string",
          "description": "真正出图的工具模型，例如 gpt-image-2.5-sunburst"
        },
        "providerMap": {
          "type": "object",
          "description": "按宿主 provider 分发不同 toolModel"
        },
        "size": {
          "type": "string"
        },
        "quality": {
          "type": "string"
        },
        "n": {
          "type": "integer"
        },
        "fallbackToOriginal": {
          "type": "boolean",
          "description": "旁路失败时是否回落官方后端"
        }
      }
    }
  }
}