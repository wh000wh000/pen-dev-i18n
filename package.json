{
  "name": "pen-dev-i18n",
  "version": "0.6.0",
  "description": "Pen (pencil.dev) 汉化补丁 —— 装上即用的中文界面（另含 11 种语言）；底层是一个通用的 Electron 运行时本地化工具",
  "type": "module",
  "bin": {
    "zh-patch": "bin/zh-patch.mjs",
    "pen-i18n": "bin/zh-patch.mjs"
  },
  "files": [
    "bin",
    "src",
    "presets",
    "dict",
    "schema",
    "docs",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/zh-patch.mjs start",
    "doctor": "node bin/zh-patch.mjs doctor",
    "test": "node bin/zh-patch.mjs manifest --json > /dev/null && node bin/zh-patch.mjs help > /dev/null && echo tests-ok"
  },
  "keywords": [
    "pen",
    "pen.dev",
    "pencil",
    "pencil.dev",
    "pen-dev",
    "汉化",
    "汉化补丁",
    "中文",
    "简体中文",
    "繁体中文",
    "chinese",
    "zh-cn",
    "localization",
    "i18n",
    "translation",
    "multi-language",
    "electron",
    "runtime-patch",
    "app-asar",
    "devtools-protocol",
    "cdp",
    "cli",
    "ai-agent",
    "agent-friendly",
    "设计工具",
    "design-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wh000wh000/pen-dev-i18n.git"
  },
