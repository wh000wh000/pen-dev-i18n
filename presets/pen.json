{
  "name": "Pen",
  "app": {
    "path": "/Applications/Pen.app",
    "processPattern": "/Applications/Pen.app/Contents/MacOS/Pen"
  },
  "debug": {
    "pagePort": 9333,
    "inspectPort": 9229
  },
  "dict": "pen.zh-CN.json",
  "engine": {
    "attrs": [
      "placeholder",
      "title",
      "aria-label",
      "alt",
      "data-placeholder"
    ],
    "skipTags": [
      "SCRIPT",
      "STYLE",
      "NOSCRIPT",
      "TEXTAREA",
      "CODE",
      "PRE"
    ],
    "skipSelector": "[contenteditable=\"true\"],[data-zh-patch-skip]",
    "pseudoAttrs": [
      "data-placeholder"
    ],
    "attrMaxLength": 160,
    "auditSkipSelector": ".agent-chat-text"
  },
  "menu": {
    "enabled": true
  },
  "lang": "zh-CN",
  "imagegen": {
    "enabled": false,
    "match": "api.pencil.dev/generate-image",
    "bridgePort": 3001,
    "bridgeUrl": "http://api.localhost:3001",
    "bridgePath": "/generate-image",
    "model": "gpt-5.5",
    "toolModel": "gpt-image-2.5-sunburst",
    "size": "1024x1024",
    "quality": "high",
    "n": 1,
    "fallbackToOriginal": true
  }
}